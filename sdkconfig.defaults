# Minimal deltas from the ESP32-P4 defaults. Everything not listed here
# falls back to the IDF default on purpose.

# Pin the target. Without this, anything that deletes sdkconfig (a clean
# checkout, tools/enable_exfat.sh, `rm sdkconfig`) regenerates it with
# IDF's default target of esp32. `idf.py fullclean` is NOT one of those: it
# empties build/ and leaves sdkconfig exactly as it was.
CONFIG_IDF_TARGET="esp32p4"

# Tab5 silicon is ESP32-P4 rev v1.3. Without this the build targets rev
# v3.1+ and esptool refuses to flash.
CONFIG_ESP32P4_SELECTS_REV_LESS_V3=y

# 16 MB flash; the 2 MB default fails partition table generation.
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y

# Console over the USB-C port.
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# 4 KB of console TX buffer, up from the 256 byte default.
#
# The USB-serial-JTAG driver discards output when its TX buffer is full
# rather than blocking the task that logged it -- the right trade for a
# console, and invisible until the log is what you are reasoning from.
#
# It cost most of an evening. A burst of six lines inside 50 ms at a
# track start lost two of them, always a contiguous run, always with
# intact lines either side. The missing pair happened to be the ones
# that would have shown the first block being queued, so the log read as
# a decode loop that stopped between the format publish and the send.
# Two probe patches went in chasing a stall that was never there; the
# tell was the third run printing every line and behaving identically.
#
# 4 KB is about eighty lines of the length this program writes, which
# covers the worst burst it has -- a track start with the probes in --
# several times over. The cost is 4 KB of internal RAM, and RETENT_RAM
# has 110 KB free at boot.
#
# The buffer only defers the loss rather than removing it: a host that
# stops draining still fills any buffer eventually. If lines go missing
# again, look for a burst first and do not assume the code stopped.
#
# 5082: AND IT WAS NEVER HERE. The line that stood below,
# CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG_TX_BUF_SIZE=4096, is not a symbol in
# IDF 5.5 -- 5077's check reported it -- so every build since 3a88a45 ran
# on the 64-byte hardware FIFO with no buffer at all. The buffer is set in
# code now: app_main() installs the USB-serial-JTAG driver with a 4 KB TX
# ring and points the console at it, before the banner.

# MP3 decode buffers live in PSRAM.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_SPEED_200M=y
CONFIG_IDF_EXPERIMENTAL_FEATURES=y

# --- display bandwidth ----------------------------------------------
#
# The other half of the underrun fix; DPI_CLOCK_MHZ in player.c is the
# demand side and this is the supply side.
#
# The DPI peripheral scans the framebuffer out of PSRAM continuously and
# has no way to wait. When it cannot fetch a line in time the DSI bridge
# raises an underrun, the panel goes cyan for a frame, and the ISR in
# esp_lcd/dsi/esp_lcd_panel_dpi.c prints
#
#   can't fetch data from external memory fast enough, underrun happens
#
# which is the line to grep for before believing any of this helped.
#
# SPIRAM_SPEED_200M above and COMPILER_OPTIMIZATION_PERF below were
# already set and are two of the four Espressif names for this symptom.
# These are the other two.
#
# Neither cache can hold a 1.8 MB framebuffer, so this is about working
# sets and transaction count rather than about keeping the picture
# resident. 256 KB is enough for the band ui_draw() is actually touching
# -- 720x560 is 806 KB, but waveform_draw_bar()'s column loop walks a
# 720x64 strip, and that fits. Longer lines turn the DPI's perfectly
# sequential read into fewer, larger fetches for the same bytes, which is
# where the overhead goes.
#
# Longer lines cut the other way for that same column loop: a one-pixel
# fill uses two bytes of whatever line it pulls, so doubling the line
# doubles what is wasted. If the cyan stops and drags feel worse, that
# loop wants rewriting row-major and this option is not the thing to
# revert.
CONFIG_CACHE_L2_CACHE_256KB=y
CONFIG_CACHE_L2_CACHE_LINE_128B=y

# Espressif lists this one too and it is deliberately left off.
#
# It moves .text and .rodata out of flash and into PSRAM, which is the
# bus the underrun is about: it buys faster instruction fetch by putting
# instruction fetch on the contended side. That may well be a net win --
# the L2 absorbs most of it and flash is the slower part -- but it is the
# one option here that can make the thing it is meant to fix worse, and
# turning it on in the same flash as the two above means never learning
# which of the three did anything.
#
# So: take the cache options, confirm the log line is gone, then enable
# this on its own and confirm it stayed gone.
# CONFIG_SPIRAM_XIP_FROM_PSRAM=y

# Enabling PSRAM grows the bootloader. Size-optimising it keeps it under
# 0x6000 so the partition table can stay at 0x8000 and partitions.csv
# (app0 @ 0x10000) remains valid.
CONFIG_BOOTLOADER_COMPILER_OPTIMIZATION_SIZE=y

# Use the checked-in partitions.csv. Without these two the build silently
# falls back to the default table and ignores that file.
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# Long file names, or every track is a mangled 8.3 name. exFAT also
# requires LFN.
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_MAX_LFN=255
CONFIG_FATFS_CODEPAGE_437=y

# readdir() returns UTF-8. This is not optional now that the font can
# draw accented characters: the default API encoding is ANSI/OEM, which
# means a file called "Björk - Jóga.mp3" comes back as codepage 437
# bytes, and 0x94 is not 'ö' in any encoding gfx.c speaks. The tags were
# already being converted properly in albumart.c; without this the
# browser's filenames would be the one place left showing mojibake, and
# only for the people whose files are affected.
#
# The codepage above still applies to short names, so it stays.
CONFIG_FATFS_API_ENCODING_UTF_8=y

# The card and a USB drive are mounted at the same time, so two logical
# FatFs volumes have to exist. Two is already the IDF default; it is
# stated here because it is now load-bearing rather than incidental. Drop
# it to one and the second mount fails, and the only symptom is a tab that
# stays greyed with a drive plugged into it.
CONFIG_FATFS_VOLUME_COUNT=2

# --- USB host -------------------------------------------------------
#
# External hubs, off by default in IDF.
#
# Without this a hub enumerates and everything behind it does not, with
# the only symptom being
#
#   W (nnn) HUB: External Hubs support disabled, Hub device was not initialized
#
# and a port that looks dead. People plug hubs into a USB-A socket; the
# stack should cope.
#
# MULTI_LEVEL as well, because a hub behind a hub is what a monitor or a
# dock is, and the failure without it is the same silent one a level
# further down.
#
# WHAT THIS DOES NOT FIX
#
# The P4's USB-A is high speed, and IDF's external hub driver has no
# Transaction Translator. A full- or low-speed device behind a hub on a
# high-speed host still will not enumerate -- which is most keyboards,
# most remotes, and the C-Media UAC headphone set this player has been
# tested against. Those have to go into the port directly.
#
# So this buys high-speed devices behind a hub, chiefly flash drives,
# and it buys an honest log line instead of a mysterious one. It does
# not make the USB-A socket general purpose, and it is not a way around
# the brownout a bus-powered keyboard causes: that is a supply problem
# and a powered hub is the fix for it, independently of this.
#
# Each downstream device needs a vacant host channel, so a hub with
# several devices on it can exhaust them. If enumeration starts failing
# with a full hub, that is the thing to look at first.
CONFIG_USB_HOST_HUBS_SUPPORTED=y
CONFIG_USB_HOST_HUB_MULTI_LEVEL=y

# Lets usbhost.c pick configuration 2 -- CDC-ECM -- on a Realtek
# RTL8152/8153 adapter, whose configuration 1 is a vendor protocol
# nothing here speaks. Without it the adapter enumerates and is ignored.
# See main/ethcfg.h. Like every line in this file it reaches an existing
# sdkconfig only after `rm sdkconfig`.
CONFIG_USB_HOST_ENABLE_ENUM_FILTER_CALLBACK=y

# esp_log_level_set() is a no-op without this on IDF v6.
CONFIG_LOG_DYNAMIC_LEVEL_CONTROL=y

CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_FREERTOS_HZ=1000

# --- decode ---------------------------------------------------------
#
# minimp3 is float by default. On the classic ESP32 that was
# disqualifying; the P4 has a single-precision FPU and the float path is
# both faster and more accurate than minimp3's fixed-point fallback, so
# it is left on. Nothing to configure -- this note exists so the absence
# of a MINIMP3_FLOAT define is read as a decision rather than an
# oversight.
#
# esp_audio_codec's decoders want roughly 20 KB of stack in whichever
# task calls them. play_file() runs on the main task.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=24576

# Do not register esp_audio_codec's MP3 decoder. decoder.c routes every
# .mp3 to our vendored minimp3 instead, so registering theirs would only
# add a decoder nothing can reach.
#
# This does NOT resolve the mp3dec_init/mp3dec_decode_frame link
# collision, which was the original reason this line was added. The
# component ships as a precompiled archive; the Kconfig option controls
# the registration source, not the archive member, so the duplicate
# symbols survive it. minimp3_prefix.h is what actually fixes that.
CONFIG_AUDIO_DECODER_MP3_SUPPORT=n

# --- the radio, which is a C6 on the other end of SDIO2 ----------------
#
# DEFER ESP-HOSTED'S INIT UNTIL app_main().
#
# esp_hosted otherwise brings the transport up from a pre-main hook, and
# on this board that cannot work: WLAN_3.3V is a load switch enabled by
# P0 of the expander at 0x44, and nothing writes that bit until app_main()
# has an I2C handle to write it with. The log of an unpatched build is
# unambiguous -- the transport starts at 1092 ms, main_task at 1096, and
# every sdmmc_card_init that follows fails against a module with no power.
#
# It also makes the Wi-Fi switch honest. settings_wifi_enabled() defaults
# false and claims that with it off nothing starts the radio; a pre-main
# hook runs before settings_init() has read the file, so the claim would
# be false the moment this dependency was added. The first build proved
# it: "Wi-Fi is off; C6 left unpowered" was logged while SDIO retried for
# another three seconds.
#
# This is upstream's own switch for the problem -- their
# mcu_transport_config example sets it for the same reason -- which is
# why the cmake patch that used to edit the constructor out of
# managed_components/ is gone. wifi.c calls esp_hosted_init() itself.
CONFIG_ESP_HOSTED_AUTO_CALL_INIT_BEFORE_APP_MAIN=n

# THE BOARD. esp_hosted carries a Tab5 preset and it was not selected --
# CONFIG_ESP_HOSTED_P4_DEV_BOARD_NONE=y in the sdkconfig of the build that
# failed. Selecting it here rather than asking anyone to find it in a menu:
# a board's wiring is not a choice on hardware that is already soldered.
CONFIG_ESP32P4_TAB5_C6_BOARD=y

# THE RESET LINE, WHICH IS NOT PART OF THE SDIO PIN CONFIG.
#
# This is the one wifi.c could not fix from code. esp_hosted_sdio_set_config()
# carries a pin_reset field, but the port reads the reset line from
# H_GPIO_PIN_RESET -- the Kconfig symbol -- not from that struct, so the
# runtime override set every data pin correctly and left reset at 54.
#
# On this board the C6's EN is SOC_EXTRF_RST on GPIO15, with a 10K pulldown.
# Left at 54 the module is never released: the SDIO peripheral configures
# against pins that are wired to a chip held in reset, "bus backend up" is
# logged, and the first RPC -- esp_wifi_init() -- waits five seconds for a
# reply from something that is not running.
CONFIG_ESP_HOSTED_HOST_RESET_GPIO=15

# AND ITS POLARITY, WHICH IS ACTIVE LOW -- upstream's default, and the
# opposite of what this file briefly said.
#
# The port's reset pulses and then PARKS at the inactive level:
#
#     gpio_set_level(pin, RESET_VAL_INACTIVE);
#     delay; gpio_set_level(pin, RESET_VAL_ACTIVE);      /* the pulse */
#     delay; gpio_set_level(pin, RESET_VAL_INACTIVE);    /* parks here */
#
# GPIO15 is the C6's EN, and EN must be left HIGH for the module to run.
# Active low gives active=0, inactive=1, so the pin parks high and the C6
# runs. Active high parks it LOW, which switches the module off a
# millisecond after pulsing it on -- fifteen sdmmc_card_init failures,
# which is what that setting produced here.
#
# The override exists for boards whose EN is behind an inverting
# transistor. This one is not: SOC_EXTRF_RST reaches EN through R4 with a
# 10K pulldown and nothing in between.
#
# Set explicitly rather than left to the default, because it was wrong
# once and a comment on an absent line cannot say why.
#
# 5082: THE LINE IS GONE BECAUSE THE OPTION IS. It read
# CONFIG_ESP_HOSTED_SDIO_RESET_ACTIVE_LOW=y, and esp_hosted 3.0.8 has no
# such symbol (5077 reported it): eh_host_port_power.c drives EN
# unconditionally -- high, LOW for the pulse, then parked HIGH -- which is
# exactly what this board needs. Proof on every boot: `reset done pin=15
# parked=1`. If a later esp_hosted grows a polarity option again, it
# must be active low, for the reasons above.

# Room for the three NIST servers wifi.c asks for. The default is 1, and
# it sizes the array that ESP_SNTP_SERVER_LIST initialises -- exceeding it
# is only a warning, so the extra servers are dropped and the build
# succeeds with one source instead of three. Keep in step with
# NTP_SERVER_COUNT in wifi.c.
CONFIG_LWIP_SNTP_MAX_SERVERS=3

# ---------------------------------------------------------------------------
# NETWORK MEMORY OUT OF INTERNAL RAM -- AN EXPERIMENT, FROM THE STREAM PROBE.
#
# Internal RAM is about 100 KB free once the player is up. One TLS session
# took 45 KB of it, and with a 512 kbit/s AAC stream running the ESP-Hosted
# host logged "mempool OOM start (RX)" every second or so, twice stalled for
# about ten seconds with TX and RX both starved, and delivered 0.15-0.73x
# real time. Internal free was 46 KB with the session up and its minimum
# fell to 38 KB. The hypothesis is that TLS and lwIP buffers are crowding
# out the transport's own; these two move the first two to PSRAM, and the
# probe logs internal heap every five seconds to say whether it helped.
#
# sdkconfig.defaults does not override an existing sdkconfig. `rm sdkconfig`
# before building; `idf.py fullclean` does not touch it. The first flash
# after this was added still had CONFIG_MBEDTLS_INTERNAL_MEM_ALLOC=y and
# TRY_ALLOCATE_WIFI_LWIP unset, and so measured nothing.
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y

# ---------------------------------------------------------------------------
# 5052: SOFTWARE AES AND SHA, SO TLS TAKES NO DMA MEMORY.
#
# The line above already put mbedTLS's buffers in PSRAM. What was left in
# internal RAM was the crypto engines' own DMA: the P4's AES and SHA
# accelerators allocate DMA descriptors, and alignment buffers, from
# DMA-capable internal RAM on every operation. With the RTL8152
# streaming and the radio starting, that pool fell to 1395 bytes and
# the engines failed mid-stream:
#
#   esp-aes: Failed to allocate memory for the array of DMA descriptors
#   esp-tls-mbedtls: read error :-0x0001
#   esp-tls-mbedtls: mbedtls_ctr_drbg_seed returned -0x0001
#
# In software they need no DMA memory at all. The cost is CPU, and not
# much of it: a radio stream is 8-40 KB/s of ciphertext against software
# AES in the tens of MB/s on a 360 MHz core, and a handshake here is
# network-bound (0.7-2.2 s of round trips). GCM goes with AES; the
# bignum and ECC engines stay, since they use no DMA.
#
# rm sdkconfig before building, as above.
# CONFIG_MBEDTLS_HARDWARE_AES is not set
# CONFIG_MBEDTLS_HARDWARE_SHA is not set

# ---------------------------------------------------------------------------
# 5054: SMALL ALLOCATIONS TO PSRAM TOO.
#
# The default sends every malloc() of 16 KB or less to internal RAM first.
# With Wi-Fi up and no USB device at all, opening an AAC stream moved
# internal free from 60 KB to 45 KB -- the esp_audio_codec decoder is a
# 14.8 KB plain malloc -- and the radio's SDIO buffers, which must be
# DMA-capable internal RAM, then failed within a second:
#
#   eh_sdio: dma_alloc(2560) failed; dropping read
#   tab5_netstream:   internal 43707 free (largest 31744), DMA 4147 free
#
# and the link never recovered. At 4096, plain allocations above 4 KB go
# to PSRAM. Drivers that need DMA memory ask for it by capability and are
# not affected. What moves is decoder state and the like, which runs a
# little slower from PSRAM and is nowhere near its time budget.
#
# rm sdkconfig before building.
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=4096

# ---------------------------------------------------------------------------
# 5072: 64 KB OF INTERNAL RAM KEPT FOR DMA, NOT 32.
#
# With 5054 in (the AAC decoder's cost down to 2568) the transport still
# died with the stream alone and one HTTPS request beside it: RFI Monde,
# settled at 64 kbit/s, 500 ms after the artwork request --
#
#   eh_sdio: dma_alloc(5120) failed; dropping read
#
# -- and the link never came back. The boot line `Reserving pool of 32K
# of internal memory for DMA/internal allocations` is the pool eh_sdio's
# dma_alloc draws on; a plain malloc() reaches it only once the rest of
# internal RAM is gone. Internal free sits near 50 KB during playback
# and 197 KB at boot, so 32 more for the pool is affordable. Task stacks
# also come from it, which is part of why it runs out.
#
# rm sdkconfig before building. Proof it took: the boot line reads
# `Reserving pool of 64K`, and the artwork line's `DMA N free` is higher.
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=65536

# ---------------------------------------------------------------------------
# NOT HERE: LWIP TCP RECEIVE TUNING. 0044 raised CONFIG_LWIP_TCP_WND_DEFAULT
# to 65534, the TCP and TCPIP receive mailboxes to 64 and turned on
# SACK_OUT, from ESP-Hosted's iperf host defaults. On hardware, idle, the
# stream's first burst took internal free from 86 KB to 44.5 KB at connect,
# and then:
#
#   W eh_sdio: dma_alloc(9216) failed; dropping read
#   W eh_sdio: rx_get_buffer(8736) failed; skipping read
#   E transport_base: esp_tls_conn_read error, errno=No more processes
#
# -- 0.06x, then the connection died. ESP-Hosted's SDIO receive path takes
# a DMA buffer from internal RAM per read and holds it until lwIP has taken
# the packet, so a window that lets the server send 64 KB ahead, and
# mailboxes that let 64 packets wait, spend internal RAM the transport
# needs. The iperf example can afford it; a player with a display, a
# decoder and a card cannot. Taken back out in 0045. Do not re-add without
# the transport's buffers somewhere other than internal RAM.

# ---------------------------------------------------------------------------
# ESP-HOSTED SDIO RECEIVE: FIXED BUFFERS, NOT STREAMING -- 5033.
#
# The default, STREAMING_MODE, reads each burst from the C6 into one of two
# DMA buffers that GROW to fit it: a burst larger than the buffer frees it
# and allocates a bigger one, contiguous, from internal DMA-capable RAM. So
# the transport needs a single 8-9 KB DMA block free at the moment traffic
# gets bursty -- the note above is that failing under TLS load, and 5030's
# board log is it failing when the DG80 was plugged in:
#
#   heap after open: ... DMA 13187 free (largest 7168)
#   eh_sdio: dma_alloc(8192) failed; dropping read
#
# 13 KB free, no 8 KB of it in one piece, and the link dead while ICMP still
# answered. RX_MAX_SIZE reads every transfer into a fixed buffer of one
# transport packet (about 1.6 KB) instead, which a fragmented heap can still
# supply. It costs SDIO throughput -- one transfer per packet rather than
# one per burst -- which a 64-320 kbit/s stream does not need.
#
# `rm sdkconfig` before building, as above. If Wi-Fi fails to come up after
# this, the C6's firmware (it reports 0.0.0) is the first suspect: put
# STREAMING_MODE back and say so in the log.
#
# TAKEN BACK IN 5036. On the board, with nothing on USB at all, the first
# ping answered, every TLS connect timed out, and then the gateway stopped
# answering too -- on two stations and across a Wi-Fi off/on. The C6
# reports firmware 0.0.0 and "CP without SDIO SW_AGGR; compatible streaming
# mode enabled": it sends streaming-framed reads, and a host reading fixed
# packet-sized buffers cannot keep up with them. Streaming mode stays until
# the coprocessor's firmware is updated to match the host (3.0.8). Written
# explicitly so a regenerated sdkconfig cannot pick up the other choice.
CONFIG_ESP_HOSTED_HOST_SDIO_RX_STREAMING_MODE=y
# CONFIG_ESP_HOSTED_HOST_SDIO_RX_MAX_SIZE is not set

# ---------------------------------------------------------------------------
# 5068: UP TO FOUR ADDRESSES PER NAME.
#
# lwIP keeps one address per DNS name by default, so getaddrinfo() could
# never offer a second when the first did not answer. live02.rfi.fr is a
# pool of twelve (Infomaniak, 60 s TTL); five attempts in 39 s all went to
# one silent member while Firefox played the station. netstream now
# resolves the host itself and moves to the next address after a failed
# connect (main/addrpin.h). Each DNS table entry grows by three addresses
# and three TTLs, which is bytes.
#
# rm sdkconfig before building. The log line that proves it took is
# `live02.rfi.fr is 185.74.70.x (1 of 4)` -- "of 1" means a stale sdkconfig.
CONFIG_LWIP_DNS_MAX_HOST_IP=4

# ---------------------------------------------------------------------------
# 5078: RECEIVED PACKETS WAIT IN PSRAM, NOT INTERNAL RAM.
#
# With a clean sdkconfig (5077 quiet under the banner, so 5072's 64K pool
# in) RFI-Afrique still logged `mempool OOM` all through a directory fetch
# and the artwork request saw `DMA 13759 free (largest 4864)` -- less than
# on the 32K build. The pool is not where the memory goes.
#
# esp_hosted 3.0.8 does not hand its SDIO buffer to lwIP. For every Wi-Fi
# frame, the rx task malloc()s payload_len bytes, copies the frame into
# it, frees the SDIO buffer, and passes the copy up
# (eh_host_bus_sdio.c, "copy_payload"). lwIP then wraps that copy without
# copying (wlanif.c, esp_pbuf_allocate) and keeps it until the packet is
# consumed -- in the tcpip mailbox, a socket's receive mailbox, the
# out-of-order queue. A frame is up to 1.5 KB; since 5054 anything under
# 4 KB is malloc'd from internal RAM first, and once the general heap is
# full a plain malloc falls through into the reserved pool as well. So a
# burst of queued frames spends the same DMA-capable RAM that the next
# SDIO buffer (1536 bytes, MALLOC_CAP_DMA) needs, and the reserve cannot
# protect it.
#
# L2_TO_L3_COPY makes wlanif copy each frame into a pbuf of its own and
# free the driver's buffer on the spot. The pbuf comes from lwIP's
# mem_malloc, which SPIRAM_TRY_ALLOCATE_WIFI_LWIP (above) sends to PSRAM
# first. Queued packets then wait in PSRAM and internal RAM holds a frame
# only for the length of a memcpy. One more copy of each packet, which at
# these rates is nothing.
#
# This is also the condition the 0044/0045 note above set for a larger
# TCP window ("the transport's buffers somewhere other than internal
# RAM"). That is not done here.
#
# rm sdkconfig before building. Proof it took: nothing under the banner
# (5077 names this key if the sdkconfig is stale).
CONFIG_LWIP_L2_TO_L3_COPY=y

# ---------------------------------------------------------------------------
# 5079: THE SDIO READ BUFFERS IN PSRAM.
#
# 5078 on the board: `mempool OOM` down from dozens of pairs to one. But
# each of the three link deaths in that log came straight after one line
# of this:
#
#   eh_sdio: dma_alloc(6656) failed; dropping read
#   eh_sdio: rx_get_buffer(6209) failed; skipping read
#
# Streaming mode reads each burst from the C6 into one of two staging
# buffers, and a burst bigger than the buffer FREES it and asks for a
# bigger one, one contiguous block (sdio_rx_get_buffer()). When that
# fails the slot is left empty, the read is skipped and the C6's queue is
# never drained; nothing after it moved. The artwork line just before
# the first one said `DMA 15639 free (largest 6400)`: enough memory, not
# in one piece.
#
# esp_hosted has an answer for P4-class chips, off by default:
# EH_HOST_PORT_DMA_PREFER_SPIRAM makes eh_host_port_dma_alloc_aligned()
# -- the staging buffers, and a 20-byte register buffer whose reads then
# bounce through the SDMMC driver's aligned buffer -- try PSRAM first and
# fall back to internal RAM. IDF turns SPIRAM|DMA into a
# cache-line-aligned PSRAM allocation (heap_align_hw.c), the P4's SDMMC
# host accepts PSRAM buffers that are line-aligned in address and size
# and syncs the cache around the transfer (sdmmc_host.c,
# sdmmc_transaction.c), and esp_hosted reads in whole 512-byte blocks,
# which are. The per-packet 1536-byte buffers still come from internal
# RAM; they go through eh_host_port_dma_alloc(), which this does not
# touch.
#
# rm sdkconfig before building. Proof it took: nothing under the banner.
# If Wi-Fi does not come up, or `Failed to read data` appears, this is
# the first suspect: take the line out and say so.
CONFIG_EH_HOST_PORT_DMA_PREFER_SPIRAM=y

# ---------------------------------------------------------------------------
# 5098: A TCP WINDOW FOR FAR-AWAY STATIONS.
#
# lwIP's default receive window is 5760 bytes, four segments. A TCP
# connection cannot move more than one window per round trip, so the
# ceiling is 5760 * 8 / RTT: about 720 kbit/s to a server 64 ms away,
# 270 kbit/s to one 170 ms away. The board has shown both. WNZK peaked
# at 723 on the cable; Спокойное радио (listen9.myradio24.com, a 320
# kbit/s stream from Russia) ran at 257-274 kbit/s on a 100 Mbit cable
# for a minute, including through the server's 64 KB connect burst,
# and the queue went from 15 s to 8 s. The link was idle; the window
# was the limit.
#
# The note above says why 0044's 64 KB window was taken out, and the
# condition for trying again: the transport's buffers somewhere other
# than internal RAM. 5078 (L2_TO_L3_COPY: queued frames are PSRAM
# pbufs), 5079 (SDIO staging buffers in PSRAM) and 5092 (packet buffers
# in PSRAM, zero mempool OOM at 512 kbit/s) are that. This is a quarter
# of 0044's window -- 16 KB covers 320 kbit/s to 400 ms of round trip
# and 512 kbit/s to 250 ms -- and a quarter of its mailbox, sized so the
# window's eleven segments can all be queued for the reader.
#
# rm sdkconfig before building. Proof it took: netstream's `ready:` line
# ends `TCP window 16384`.
CONFIG_LWIP_TCP_WND_DEFAULT=16384
CONFIG_LWIP_TCP_RECVMBOX_SIZE=16
