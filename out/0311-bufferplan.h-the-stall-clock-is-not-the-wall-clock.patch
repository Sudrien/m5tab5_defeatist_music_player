-++    checks++;                                           \
-++    if (!(cond)) {                                      \
-++        failures++;                                     \
-++        printf("  FAIL %s:%d: ", __FILE__, __LINE__);   \
-++        printf(__VA_ARGS__);                            \
-++        printf("\n");                                   \
-++    }                                                   \
-++} while (0)
-++
