# 5038: the USB rate converter's per-sample code in IRAM, not flash.
#
# The board measured esp_ae_rate_cvt at 234% of real time converting
# 44.1 -> 48 kHz stereo (5037's log), where the same objects under qemu
# count about 37 M instructions per second of audio -- a tenth of a core.
# The flash on this board runs 40 MHz DIO, and code executed in place is
# fetched through a cache the decoder, the display and everything else are
# also running through; an inner loop evicted from it waits on that bus.
# rsp_proc holds the per-sample paths (fa_resample_process and friends),
# about 5.3 KB of internal RAM. The 64-bit divide they call, __divdi3,
# already resolves to the chip ROM (0x4fc0....) and needs no mapping.
[mapping:esp_ae_rate_cvt_iram]
archive: libesp_audio_effects.a
entries:
    rsp_proc (noflash)
